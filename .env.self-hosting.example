# Copy to .env (ignored by Git). Generate each secret separately:
# openssl rand -hex 32
# Database passwords must be URL-safe; hex avoids connection-string escaping.
POSTGRES_PASSWORD=
DATOOL_ALERT_READER_PASSWORD=
BETTER_AUTH_SECRET=

# Public HTTPS origin, with no trailing path. Terminate TLS in your reverse proxy.
BETTER_AUTH_URL=https://datool.example.com
# Loopback-only upstream port for that proxy; databases have no published ports.
DATOOL_HTTP_PORT=3030

# Allow exact email domains. List subdomains separately.
AUTH_ALLOWED_DOMAINS=example.com
# Use true only if anyone with a verified email should be able to create an account.
AUTH_ALLOW_PUBLIC_SIGNUP=false

# Configure at least one sign-in method (both may be configured).
# Magic links: a Resend API key and a verified sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Google web OAuth callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional CMS and Cloud marketing site. Keep off for an application-only install.
DATOOL_CMS_ENABLED=false
# Required when enabling CMS; generate independently of BETTER_AUTH_SECRET.
PAYLOAD_SECRET=
# Allowlisted Better Auth user IDs; empty denies CMS editing.
CMS_ADMIN_USER_IDS=

# Optional Build agents, UI, APIs, MCP tools, public chat, and background jobs.
# Runtime opt-in: set true on both web and Build worker, then restart them.
DATOOL_BUILD_ENABLED=false
# Optional comma-separated organization IDs for a limited rollout while the flag is false.
# Use the same values on web and build-worker; restart both after changes.
DATOOL_BUILD_ORGANIZATION_IDS=

# Optional WhatsApp Embedded Signup. See /docs/guides/whatsapp.
# Set on both web and Build worker. These are server-only settings.
DATOOL_PUBLIC_URL=
DATOOL_ZERNIO_API_KEY=
DATOOL_ZERNIO_WEBHOOK_SECRET=
DATOOL_META_APP_ID=
DATOOL_META_APP_SECRET=
DATOOL_META_WHATSAPP_CONFIG_ID=
DATOOL_META_WEBHOOK_VERIFY_TOKEN=
DATOOL_META_GRAPH_VERSION=v23.0

# Optional app connections for Build agents. Configure the same values on web and worker.
# Enable only audited app/tool combinations and set a conservative per-attempt rate.
COMPOSIO_API_KEY=
DATOOL_COMPOSIO_APPS={}
# See docs/composio-integrations.md for the JSON shape and Google Calendar example.
