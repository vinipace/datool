{
  "name": "datool",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "examples/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "fumadocs-mdx && node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "check:pre-push": "bun run lint && bun run check:styles && bun run typecheck && bun test tests/style-guard.test.ts tests/ui-controls.test.tsx tests/git-hooks.test.ts",
    "check:docs": "bun test tests/docs-content.test.ts tests/docs-page-tree.test.ts tests/docs-responses.test.ts && node scripts/generate-agent-output-schemas.mjs --check && bun --no-env-file scripts/generate-docs-reference.ts --check",
    "check:skills": "node scripts/validate-skills.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "dev": "bun run build:monaco && next dev",
    "db:init": "bun run scripts/migrate.ts",
    "db:alerts-reader": "bun run scripts/provision-alert-reader.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "vercel:build": "bun run scripts/vercel-build.ts",
    "demo:trace": "bun run scripts/demo-trace.ts",
    "build": "bun run check:docs && bun run build:monaco && next build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test tests",
    "verify:v1": "bun run scripts/verify-v1.ts",
    "verify:semantic": "bun run scripts/verify-semantic.ts",
    "lint": "eslint app components lib src scripts tests next.config.ts drizzle.config.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json}\"",
    "build:monaco": "bun run scripts/build-monaco.mjs && node scripts/build-trace-views.mjs",
    "connect": "bun --no-env-file bin/datool.ts connect",
    "worker:ingestion": "bun run scripts/ingestion-worker.ts",
    "worker:alerts": "bun run scripts/alerts-worker.ts",
    "test:alerts:e2e": "bun run build:monaco && bun run scripts/test-alerts-e2e.ts",
    "import:langfuse": "bun run scripts/langfuse-import.ts",
    "worker:imports": "bun run scripts/langfuse-import.ts worker",
    "ingestion:jobs": "bun run scripts/ingestion-jobs.ts",
    "test:self-hosting": "bash scripts/test-self-hosting.sh",
    "test:load": "bun --no-env-file scripts/load-ingestion.ts",
    "build:packages": "bun run scripts/build-packages.ts",
    "pack:packages": "bun run build:packages && bun run scripts/pack-packages.ts",
    "test:packages": "bun test tests/cli-request.test.ts tests/cli-config.test.ts tests/cli-oauth.test.ts && bun run scripts/test-packages.ts",
    "test:cli:distribution": "node scripts/test-cli-distribution.mjs",
    "test:packages:integration": "bun run scripts/test-packages-integration.ts",
    "test:agent:e2e": "bun run pack:packages && bun run scripts/test-agent-foundations-e2e.ts",
    "check:release": "bun run scripts/check-package-release.ts",
    "storybook": "bun run build:monaco && storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "bun run build:monaco && storybook build --disable-telemetry",
    "test:storybook": "bun run build:monaco && vitest run --project=storybook",
    "lint:storybook": "eslint --no-error-on-unmatched-pattern .storybook 'components/**/*.stories.tsx' 'app/**/*.stories.tsx' vitest.config.mts scripts/check-storybook-coverage.mjs tests/storybook-coverage.test.ts",
    "storybook:coverage": "node scripts/check-storybook-coverage.mjs",
    "cms:generate:types": "payload generate:types",
    "cms:generate:importmap": "payload generate:importmap",
    "cms:migrate:create": "payload migrate:create",
    "cms:migrate": "payload migrate",
    "cms:migrate:status": "payload migrate:status",
    "cms:seed": "node --import tsx scripts/seed-cms.ts",
    "test:cms": "node --import tsx tests/cms.integration.ts",
    "test:cms:http": "node --import tsx tests/cms-http.integration.ts",
    "test:home:http": "node --import tsx tests/home-http.integration.ts",
    "test:agents:http": "node --import tsx tests/agent-readiness-http.integration.ts",
    "test:cms:markdown": "node --import tsx --test tests/cms-markdown.integration.ts",
    "test:python:integration": "bun --no-env-file scripts/test-python-sdk.ts",
    "generate:api": "node scripts/generate-agent-output-schemas.mjs && bun --no-env-file scripts/generate-docs-reference.ts",
    "check:docs:links": "bun --no-env-file scripts/check-doc-links.ts",
    "test:docs:http": "node --import tsx tests/docs-markdown-http.integration.ts",
    "test:react-views:e2e": "bun run build:monaco && bun --no-env-file scripts/test-react-views-e2e.ts"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^9.39.4",
    "@napi-rs/keyring": "2.0.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@shadcn/lint": "^0.1.0",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-themes": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@tiptap/core": "^3.22.1",
    "@tiptap/extension-document": "^3.22.1",
    "@tiptap/extension-paragraph": "^3.22.1",
    "@tiptap/extension-placeholder": "^3.22.1",
    "@tiptap/extension-text": "^3.22.1",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "^3.22.1",
    "@tiptap/react": "^3.22.1",
    "@tiptap/starter-kit": "3.31.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.23.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "bun-types": "^1.2.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csstype": "3.2.3",
    "date-fns": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "github-slugger": "2.0.0",
    "globals": "^16.5.0",
    "lucide-react": "^0.577.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "1.62.1",
    "postcss": "8.5.23",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "10.5.10",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tsup": "8.5.1",
    "tsx": "4.20.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.85",
    "@ai-sdk/typesafe-ai": "3.0.2",
    "@base-ui/react": "^1.8.0",
    "@better-auth/api-key": "^1.7.3",
    "@better-auth/oauth-provider": "^1.7.3",
    "@mdx-js/mdx": "3.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@next/env": "16.3.4",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@vercel/sandbox": "^3.3.0",
    "@xyflow/react": "^12.11.6",
    "ai": "^7.0.105",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoevals": "0.3.0",
    "better-auth": "^1.7.3",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.102",
    "fumadocs-core": "16.15.11",
    "fumadocs-mdx": "15.4.1",
    "fumadocs-ui": "16.15.11",
    "graphql": "16.11.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.5",
    "modal": "^0.10.1",
    "monaco-editor": "^0.57.0",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "payload": "3.90.2",
    "pg": "^8.23.0",
    "prismjs": "^1.30.0",
    "react-grid-layout": "2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "server-only": "0.0.1",
    "stripe": "^22.6.2",
    "tokenlens": "1.3.1",
    "unified": "11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  },
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinipace/datool.git"
  },
  "overrides": {
    "image-size": "2.0.4",
    "esbuild": "0.28.2"
  }
}
