{
  "name": "@datool/react",
  "version": "0.1.0",
  "description": "Embedded Datool chat with server-authenticated application context.",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinipace/datool.git",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "bun ../../scripts/build-packages.ts react",
    "prepack": "bun run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@datool/sdk": "^0.3.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
