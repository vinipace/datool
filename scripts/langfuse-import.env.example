# Copy to .env.langfuse-import.local (ignored by Git).
# Both Datool services MUST use loopback hosts for this local import command.
DATABASE_URL=
REDIS_URL=

# Langfuse Cloud region URL or your self-hosted base URL (without /api/public).
# EU: https://cloud.langfuse.com ; US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
