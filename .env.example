# PostgreSQL used for Better Auth, organizations, projects, traces, and evaluations.
DATABASE_URL=postgresql://datool:datool@localhost:5432/datool

# Dedicated alert reader, provision after migrations with bun run db:alerts-reader.
# Never reuse the application database login. Missing/unsafe credentials fail closed.
DATOOL_ALERT_DATABASE_URL=

# Generate a long random value, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional separate secret (32+ characters) for encrypted project provider keys.
# Defaults to a domain-separated key derived from BETTER_AUTH_SECRET.
# Keep stable; changing it requires re-entering all saved provider API keys.
DATOOL_PROVIDER_ENCRYPTION_KEY=
BETTER_AUTH_URL=http://localhost:3000

# Optional SDK ingestion credentials. DATOOL_PROJECT_ID must be a project that
# belongs to the organization whose traces and evaluations it receives.
DATOOL_API_KEY=
DATOOL_PROJECT_ID=

# Optional Google web OAuth client. Configure the callback as:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated exact email domains. Empty denies Google sign-ins unless public signup is enabled.
AUTH_ALLOWED_DOMAINS=

# Sign-in links and organization invitation emails. Use a Resend key and verified sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Datool <invites@your-verified-domain.com>

# Editorial CMS. Uses its own `payload` schema; app migrations remain separate.
# Off by default: no marketing site, CMS routes, schema, or CMS secret required.
DATOOL_CMS_ENABLED=false
# Optional public contact email for pricing inquiries. Empty hides contact links.
DATOOL_CONTACT_EMAIL=
PAYLOAD_SECRET=
# Optional separate database; otherwise uses DATABASE_URL.
PAYLOAD_DATABASE_URL=
# Comma-separated Better Auth user IDs allowed to edit /cms. Empty denies access.
CMS_ADMIN_USER_IDS=
# Subset of CMS admins allowed to view all organizations, subscriptions, and usage.
SYSTEM_ADMIN_USER_IDS=

# Optional extra exact browser origins for MCP clients. Native clients need none.
DATOOL_MCP_ALLOWED_ORIGINS=

# Redis queue shared by the API and persistent ingestion worker.
REDIS_URL=redis://localhost:6379
# Polling cache budgets in bytes, shared across all app processes.
# 0 disables admission. Keep identical on every process; leave headroom for queues.
DATOOL_POLLING_CACHE_PROJECT_BYTES=4194304
DATOOL_POLLING_CACHE_GLOBAL_BYTES=67108864

# Explicitly allow any verified Google or magic-link email to sign up.
AUTH_ALLOW_PUBLIC_SIGNUP=false

# Opt-in Cloud subscriptions. Self-hosted installations need no Stripe credentials.
DATOOL_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Active fixed monthly USD prices: Core US$29, Pro US$199.
STRIPE_CORE_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Optional explicit portal configuration; otherwise Stripe's default is used.
STRIPE_PORTAL_CONFIGURATION_ID=
# One trial per Stripe customer. 0 disables trials; range: 0-30 days.
DATOOL_BILLING_TRIAL_DAYS=0

# Optional private operator alerts. A new paid subscription produces one Slack
# notification; trials and renewals are excluded. Delivery is best effort.
# Configure a bot with chat:write, invited to the destination channel.
SLACK_BOT_TOKEN=
SLACK_SUBSCRIPTIONS_CHANNEL=
# Deployment jobs use these in CI, independently of product notifications.
# Share the bot token, but configure the deployment destination separately.
SLACK_DEPLOYMENTS_CHANNEL=

# Datool-funded scorers and sandboxes. Requires Cloud billing, migration 0041,
# provider credentials and a verified paid invoice. Never expose these keys.
DATOOL_MANAGED_EXECUTION_ENABLED=false
DATOOL_SCORER_OPENAI_API_KEY=
DATOOL_MODAL_TOKEN_ID=
DATOOL_MODAL_TOKEN_SECRET=
