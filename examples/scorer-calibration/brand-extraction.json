{
  "rubric": "Extract only brands supported by the response. Known-brand context is not answer evidence. Grounding rejects every unsupported emitted entity, even when isTextMentioned=false or mentionCount=0. Coverage assesses only omissions of supported brands; extra entities do not lower coverage. A loading placeholder supports no brands, so coverage passes vacuously while input validity fails. Missing response evidence yields skip for grounding and coverage. These are explicit decisions for this rubric, not universal extraction rules.",
  "origin": "synthetic, deliberately reviewed fixtures; never production gold",
  "fixtures": [
    {
      "id": "known-pass",
      "input": { "response": "Acme and Nexa both sell shoes.", "knownBrands": ["Acme", "Nexa", "Omni"] },
      "output": { "brands": [{ "name": "Acme", "isTextMentioned": true, "mentionCount": 1 }, { "name": "Nexa", "isTextMentioned": true, "mentionCount": 1 }] },
      "expectedJudgments": { "grounding": "pass", "coverage": "pass", "inputValidity": "pass" }
    },
    {
      "id": "loading-placeholder-unsupported-brands",
