      "expectedJudgments": { "grounding": "fail", "coverage": "pass", "inputValidity": "fail" }
    },
    {
      "id": "grounded-but-incomplete",
      "input": { "response": "Acme and Nexa both sell shoes.", "knownBrands": ["Acme", "Nexa"] },
      "output": { "brands": [{ "name": "Acme", "isTextMentioned": true, "mentionCount": 1 }] },
      "expectedJudgments": { "grounding": "pass", "coverage": "fail", "inputValidity": "pass" }
    },
    {
      "id": "complete-with-unsupported-extra",
      "input": { "response": "Acme sells shoes.", "knownBrands": ["Acme", "Nexa"] },
      "output": { "brands": [{ "name": "Acme", "isTextMentioned": true, "mentionCount": 1 }, { "name": "Nexa", "isTextMentioned": false, "mentionCount": 0 }] },
      "expectedJudgments": { "grounding": "fail", "coverage": "pass", "inputValidity": "pass" }
