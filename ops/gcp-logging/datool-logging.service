[Unit]
Description=Datool logs to Google Cloud Logging
After=network-online.target docker.service
Wants=network-online.target
Requires=datool-log-discovery.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStartPre=/opt/fluent-bit/bin/fluent-bit --dry-run -c /etc/datool-logging/fluent-bit.conf
ExecStart=/opt/fluent-bit/bin/fluent-bit -c /etc/datool-logging/fluent-bit.conf
Restart=always
RestartSec=10
StateDirectory=datool-logging
StateDirectoryMode=0700
MemoryMax=256M
CPUQuota=25%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/run/docker.sock
ReadWritePaths=/var/lib/datool-logging

[Install]
WantedBy=multi-user.target
