[Unit]
Description=Discover Datool container log files
After=docker.service
Requires=docker.service
Before=datool-logging.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/datool-log-discovery
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/datool-logging
