[Unit]
Description=Encrypted Datool recovery backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/datool-backup/restic.env
Environment=GOMAXPROCS=1
ExecStart=/usr/bin/python3 /opt/datool-backup/backup.py /etc/datool-backup/config.json
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=1G
TimeoutStartSec=2h
KillMode=control-group
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
